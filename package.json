{
  "name": "hub-evidence-anchor",
  "version": "0.1.0",
  "description": "On-chain behavioral trust oracle for Solana agents",
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
